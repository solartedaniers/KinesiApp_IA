# Secreto compartido con el backend (mínimo 32 caracteres). Sin él la IA no arranca.
AI_SERVICE_TOKEN=

# Servidor gRPC interno; Envoy es lo único expuesto.
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
GRPC_SHUTDOWN_GRACE_SECONDS=5

# Hosts desde los que se pueden descargar videos, en JSON. Obligatorio: es el host del endpoint de Neon Storage.
VIDEO_DOWNLOAD_ALLOWED_HOSTS=["xxx.storage.c-6.eu-central-1.aws.neon.tech"]
VIDEO_DOWNLOAD_MAX_BYTES=104857600
VIDEO_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
VIDEO_DOWNLOAD_TOTAL_TIMEOUT_SECONDS=120
VIDEO_DOWNLOAD_MAX_REDIRECTS=3

# Límites de cada análisis. Con 512 MB de RAM, un análisis a la vez.
ANALYSIS_MAX_CONCURRENCY=1
ANALYSIS_MAX_VIDEO_DURATION_SECONDS=40
# Lado mayor máximo de cada frame en píxeles; vacío para analizar a la resolución original.
ANALYSIS_MAX_FRAME_SIDE_PX=
# Tope de frames por segundo que analizo; vacío para usar todos. Bajarlo cambia los puntajes.
ANALYSIS_MAX_FPS=
# Cada cuántos frames corro YOLO; entre medias sostengo el recorte de la persona.
PERSON_DETECTOR_INTERVAL_FRAMES=1
# Hilos de YOLO; vacío para uno por núcleo. Con la CPU fraccionada de Render, 1 rinde mucho más.
PERSON_DETECTOR_THREADS=
ANALYSIS_PROGRESS_EVERY_FRAMES=10

# Asistente. La clave es obligatoria: sin ella la IA no arranca.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Opcional: modelo al que recurro una sola vez si el principal responde 503 antes de mandar texto
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_SECONDS=30
GEMINI_FIRST_TEXT_TIMEOUT_SECONDS=12
GEMINI_MAX_OUTPUT_TOKENS=1024
# MINIMAL, LOW, MEDIUM o HIGH. Lo bajo a LOW porque con el del modelo el razonamiento se comía casi toda la salida
GEMINI_THINKING_LEVEL=LOW
CHAT_QUESTION_MAX_CHARS=1000
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_PROMPT_MAX_REPETITIONS=5
